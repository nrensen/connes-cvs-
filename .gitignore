# =============================================================
# .gitignore for connes-cvs
# =============================================================

# ---- Python / build artifacts ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
*.whl
*.pickle
.pytest_cache/
.venv/
venv/

# ---- Local secrets ----
.env

# ---- OS / editor ----
.DS_Store
.vscode/

# ---- PyPI release staging (built artifacts, never committed) ----
release-dist/

# ---- Working material that must never enter this repository ----
*_private_rc*
*_HELD_*
*_in_prep*
proof_objects/
.cell_cache/
