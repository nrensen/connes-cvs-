------------------------------------------------------------------------
2. CURRENT G_complex
------------------------------------------------------------------------
def G_complex(v, z, L):
    """
    Complex analytic response G_v(z).
    """

    return sum(
        v[k]
        * G_complex_basis(k, z, L)
        for k in range(len(v))
    )


------------------------------------------------------------------------
HISTORICAL CELL-5 G_complex
------------------------------------------------------------------------
def G_complex(v, z):
    total = mp.mpc(0)

    for k in range(N + 1):
        total += (
            v[k]
            * G_complex_from_canonical_basis(k, z)
        )

    return total


